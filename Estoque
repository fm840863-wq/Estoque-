<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Controle de Estoque</title>
<script src="https://unpkg.com/html5-qrcode/html5-qrcode.min.js"></script>
<style>
  :root {
    --bg: #f5f6f8; --card: #fff; --text: #1f2937; --muted: #6b7280;
    --border: #e5e7eb; --primary: #2563eb; --danger: #dc2626;
  }
  * { box-sizing: border-box; }
  body { margin: 0; padding-bottom: 40px; background: var(--bg); color: var(--text);
         font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
  header { position: sticky; top: 0; z-index: 10; background: var(--card);
           padding: 16px; border-bottom: 1px solid var(--border); }
  h1 { font-size: 20px; margin: 0 0 12px; }
  nav { display: flex; gap: 8px; flex-wrap: wrap; }
  .tab { border: 1px solid var(--border); background: transparent; color: var(--text);
         padding: 8px 14px; border-radius: 999px; cursor: pointer; font-size: 14px; }
  .tab.active { background: var(--primary); color: #fff; border-color: var(--primary); }
  main { max-width: 1000px; margin: 0 auto; padding: 16px; }
  .tab-panel { display: none; }
  .tab-panel.active { display: block; }
  form { background: var(--card); padding: 16px; border-radius: 12px;
         border: 1px solid var(--border); margin-bottom: 16px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 12px; }
  label { display: flex; flex-direction: column; gap: 4px; font-size: 13px; color: var(--muted); }
  input, select { width: 100%; padding: 8px 10px; border: 1px solid var(--border);
                  border-radius: 8px; font-size: 15px; color: var(--text); background: #fff; }
  button { cursor: pointer; border: none; background: var(--primary); color: #fff;
           padding: 10px 16px; border-radius: 8px; font-size: 14px; }
  button.danger { background: var(--danger); margin-top: 12px; }
  .row { display: flex; gap: 8px; margin-top: 12px; flex-wrap: wrap; }
  .toolbar { margin-bottom: 12px; }
  .table-wrap { overflow-x: auto; background: var(--card);
                border-radius: 12px; border: 1px solid var(--border); }
  table { width: 100%; border-collapse: collapse; font-size: 14px; }
  th, td { padding: 10px 12px; text-align: left; border-bottom: 1px solid var(--border); white-space: nowrap; }
  th { font-size: 12px; text-transform: uppercase; color: var(--muted); }
  tr.low td { background: #fffbeb; }
  .num { text-align: right; }
  .actions button { padding: 4px 8px; font-size: 13px; }
  .empty { color: var(--muted); text-align: center; padding: 20px; }
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
           gap: 12px; margin-bottom: 20px; }
  .card { background: var(--card); border: 1px solid var(--border);
          border-radius: 12px; padding: 14px; display: flex; flex-direction: column; gap: 6px; }
  .card span { font-size: 13px; color: var(--muted); }
  .card strong { font-size: 22px; }
  .hint { font-size: 12px; color: var(--muted); margin-top: 8px; }
  #lowList { list-style: none; padding: 0; }
  #lowList li { padding: 8px 12px; background: #fffbeb; border: 1px solid #f59e0b;
                border-radius: 8px; margin-bottom: 6px; }
  #lowList li.empty { background: transparent; border: none; }

  /* Campo com botão de scan */
  .form-field { display: flex; flex-direction: column; gap: 4px; }
  .form-field > label { display: block; font-size: 13px; color: var(--muted); }
  .input-with-btn { display: flex; gap: 6px; align-items: stretch; }
  .input-with-btn > input,
  .input-with-btn > select { flex: 1; width: auto; min-width: 0; }
  .scan-btn {
    background: #10b981; color: #fff; border: none; border-radius: 8px;
    padding: 8px 14px; font-size: 18px; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: background 0.15s;
  }
  .scan-btn:hover { background: #059669; }
  .scan-btn:active { background: #047857; }

  /* Modal do scanner */
  .modal {
    display: none; position: fixed; inset: 0;
    background: rgba(0,0,0,0.75); z-index: 100;
    align-items: center; justify-content: center; padding: 16px;
  }
  .modal.open { display: flex; }
  .modal-content {
    background: #fff; border-radius: 12px; max-width: 520px; width: 100%;
    padding: 16px; max-height: 90vh; overflow: auto;
  }
  .modal-header {
    display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;
  }
  .modal-header h2 { margin: 0; font-size: 16px; }
  .modal-close {
    background: transparent; color: #1f2937; border: none;
    font-size: 22px; padding: 4px 10px; border-radius: 6px; cursor: pointer; line-height: 1;
  }
  .modal-close:hover { background: #f3f4f6; }
  #reader { width: 100%; border-radius: 8px; overflow: hidden; background: #000; min-height: 200px; }
  #reader video { border-radius: 8px; }
</style>
</head>
<body>

<header>
  <h1>📦 Controle de Estoque</h1>
  <nav>
    <button class="tab active" data-tab="produtos">Produtos</button>
    <button class="tab" data-tab="mov">Movimentações</button>
    <button class="tab" data-tab="resumo">Resumo</button>
  </nav>
</header>

<main>
  <!-- ABA PRODUTOS -->
  <section id="tab-produtos" class="tab-panel active">
    <form id="productForm">
      <div class="grid">
        <div class="form-field">
          <label for="pCodigo">Código</label>
          <div class="input-with-btn">
            <input id="pCodigo">
            <button type="button" id="scanBtn" class="scan-btn" title="Escanear código de barras">📷</button>
          </div>
        </div>
        <label>Nome *<input id="pNome" required></label>
        <label>Categoria<input id="pCategoria"></label>
        <label>Preço unitário (R$)<input id="pPreco" type="number" step="0.01" min="0" value="0"></label>
        <label>Estoque mínimo<input id="pMinimo" type="number" min="0" value="0"></label>
        <label id="qtdInicialWrap">Quantidade inicial<input id="pQtd" type="number" min="0" value="0"></label>
        <label>Fornecedor<input id="pFornecedor"></label>
      </div>
      <div class="row">
        <button type="submit" id="saveBtn">Salvar produto</button>
        <button type="button" id="cancelEdit" style="background:#e5e7eb;color:#1f2937" hidden>Cancelar edição</button>
      </div>
      <p class="hint" id="editHint" hidden>Para alterar a quantidade, use a aba Movimentações.</p>
    </form>

    <div class="toolbar">
      <input id="search" placeholder="Buscar por nome, código ou categoria...">
    </div>

    <div class="table-wrap">
      <table>
        <thead><tr>
          <th>Código</th><th>Nome</th><th>Categoria</th><th>Qtd</th>
          <th>Mín</th><th>Preço</th><th>Total</th><th></th>
        </tr></thead>
        <tbody id="productsBody"></tbody>
      </table>
    </div>
  </section>

  <!-- ABA MOVIMENTAÇÕES -->
  <section id="tab-mov" class="tab-panel">
    <form id="movForm">
      <div class="grid">
        <div class="form-field">
          <label for="mProduto">Produto</label>
          <div class="input-with-btn">
            <select id="mProduto" required></select>
            <button type="button" id="scanMovBtn" class="scan-btn" title="Escanear produto">📷</button>
          </div>
        </div>
        <label>Tipo<select id="mTipo">
          <option value="entrada">Entrada</option>
          <option value="saida">Saída</option>
        </select></label>
        <label>Quantidade<input id="mQtd" type="number" min="1" value="1" required></label>
        <label>Observação<input id="mObs"></label>
      </div>
      <div class="row"><button type="submit">Registrar movimentação</button></div>
    </form>

    <div class="table-wrap">
      <table>
        <thead><tr><th>Data</th><th>Produto</th><th>Tipo</th><th>Qtd</th><th>Obs</th></tr></thead>
        <tbody id="movBody"></tbody>
      </table>
    </div>
    <button id="clearMov" class="danger">Limpar histórico</button>
  </section>

  <!-- ABA RESUMO -->
  <section id="tab-resumo" class="tab-panel">
    <div class="cards" id="summaryCards"></div>
    <h2>Itens abaixo do mínimo</h2>
    <ul id="lowList"></ul>
    <h2>Backup</h2>
    <div class="row">
      <button id="exportBtn">Exportar dados (JSON)</button>
      <label style="flex-direction:row;align-items:center;gap:8px;background:#e5e7eb;padding:10px 16px;border-radius:8px;cursor:pointer;color:#1f2937;font-size:14px">
        Importar dados<input type="file" id="importFile" accept="application/json" hidden>
      </label>
    </div>
    <p class="hint">Os dados ficam salvos apenas neste navegador/dispositivo.
    Para usar no celular e no PC, exporte o JSON em um e importe no outro.
    Faça backups periódicos — limpar dados do navegador apaga tudo.</p>
  </section>
</main>

<!-- MODAL DO SCANNER -->
<div id="scannerModal" class="modal">
  <div class="modal-content">
    <div class="modal-header">
      <h2>📷 Escanear código</h2>
      <button type="button" class="modal-close" id="closeScanner">✕</button>
    </div>
    <div id="reader"></div>
    <p class="hint">Aponte a câmera para o código de barras.</p>
  </div>
</div>

<script>
"use strict";

// ---------- Utilidades ----------
const $ = id => document.getElementById(id);
const LS_KEY = 'estoque_v1';
const uid = () => Date.now().toString(36) + Math.random().toString(36).slice(2, 8);
const fmtMoney = v => (Number(v) || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
const fmtDate = iso => new Date(iso).toLocaleString('pt-BR');
const esc = s => String(s ?? '').replace(/[&<>"']/g,
  c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

// ---------- Estado ----------
let state = { products: [], movements: [] };
let editingId = null;

function load() {
  const raw = localStorage.getItem(LS_KEY);
  if (raw) { try { state = JSON.parse(raw); } catch (e) { console.error(e); } }
  if (!Array.isArray(state.products)) state.products = [];
  if (!Array.isArray(state.movements)) state.movements = [];
}
function save() { localStorage.setItem(LS_KEY, JSON.stringify(state)); }

// ---------- Navegação ----------
document.querySelectorAll('.tab').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.tab').forEach(b => b.classList.toggle('active', b === btn));
    document.querySelectorAll('.tab-panel').forEach(p =>
      p.classList.toggle('active', p.id === 'tab-' + btn.dataset.tab));
  });
});

// ---------- Produtos: formulário ----------
function resetForm() {
  editingId = null;
  $('productForm').reset();
  $('saveBtn').textContent = 'Salvar produto';
  $('cancelEdit').hidden = true;
  $('qtdInicialWrap').hidden = false;
  $('editHint').hidden = true;
}
$('cancelEdit').addEventListener('click', resetForm);

$('productForm').addEventListener('submit', e => {
  e.preventDefault();
  const dados = {
    codigo: $('pCodigo').value.trim(),
    nome: $('pNome').value.trim(),
    categoria: $('pCategoria').value.trim(),
    preco: Number($('pPreco').value) || 0,
    minimo: Number($('pMinimo').value) || 0,
    fornecedor: $('pFornecedor').value.trim()
  };
  if (!dados.nome) return;

  if (editingId) {
    const p = state.products.find(x => x.id === editingId);
    if (p) Object.assign(p, dados);
  } else {
    const qtdInicial = Math.max(0, Math.floor(Number($('pQtd').value) || 0));
    const p = { id: uid(), qtd: qtdInicial, ...dados };
    state.products.push(p);
    if (qtdInicial > 0) {
      state.movements.push({
        id: uid(), productId: p.id, tipo: 'entrada',
        qtd: qtdInicial, data: new Date().toISOString(), obs: 'Estoque inicial'
      });
    }
  }
  save(); resetForm(); renderAll();
});

function startEdit(id) {
  const p = state.products.find(x => x.id === id);
  if (!p) return;
  editingId = id;
  $('pCodigo').value = p.codigo || '';
  $('pNome').value = p.nome;
  $('pCategoria').value = p.categoria || '';
  $('pPreco').value = p.preco;
  $('pMinimo').value = p.minimo;
  $('pFornecedor').value = p.fornecedor || '';
  $('saveBtn').textContent = 'Salvar alterações';
  $('cancelEdit').hidden = false;
  $('qtdInicialWrap').hidden = true;
  $('editHint').hidden = false;
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

function deleteProduct(id) {
  const p = state.products.find(x => x.id === id);
  if (!p) return;
  if (!confirm(`Excluir "${p.nome}"? As movimentações dele também serão removidas.`)) return;
  state.products = state.products.filter(x => x.id !== id);
  state.movements = state.movements.filter(m => m.productId !== id);
  save(); renderAll();
}

// ---------- Produtos: tabela ----------
function renderProducts() {
  const q = $('search').value.toLowerCase().trim();
  const tbody = $('productsBody');
  tbody.innerHTML = '';
  const lista = state.products
    .filter(p => !q
      || p.nome.toLowerCase().includes(q)
      || (p.codigo || '').toLowerCase().includes(q)
      || (p.categoria || '').toLowerCase().includes(q))
    .sort((a, b) => a.nome.localeCompare(b.nome));

  if (lista.length === 0) {
    tbody.innerHTML = '<tr><td colspan="8" class="empty">Nenhum produto cadastrado ainda.</td></tr>';
    return;
  }
  for (const p of lista) {
    const tr = document.createElement('tr');
    if (p.qtd <= p.minimo) tr.classList.add('low');
    tr.innerHTML = `
      <td>${esc(p.codigo)}</td>
      <td>${esc(p.nome)}</td>
      <td>${esc(p.categoria)}</td>
      <td class="num">${p.qtd}</td>
      <td class="num">${p.minimo}</td>
      <td class="num">${fmtMoney(p.preco)}</td>
      <td class="num">${fmtMoney(p.qtd * p.preco)}</td>
      <td class="actions">
        <button data-act="in"  data-id="${p.id}" title="Entrada">+</button>
        <button data-act="out" data-id="${p.id}" title="Saída">−</button>
        <button data-act="edit" data-id="${p.id}" title="Editar">✎</button>
        <button data-act="del"  data-id="${p.id}" style="background:#dc2626" title="Excluir">🗑</button>
      </td>`;
    tbody.appendChild(tr);
  }
}
$('search').addEventListener('input', renderProducts);

$('productsBody').addEventListener('click', e => {
  const btn = e.target.closest('button[data-act]');
  if (!btn) return;
  const { act, id } = btn.dataset;
  if (act === 'in') quickMove(id, 'entrada');
  else if (act === 'out') quickMove(id, 'saida');
  else if (act === 'edit') startEdit(id);
  else if (act === 'del') deleteProduct(id);
});

// ---------- Movimentações ----------
function quickMove(id, tipo) {
  document.querySelector('.tab[data-tab="mov"]').click();
  $('mProduto').value = id;
  $('mTipo').value = tipo;
  $('mQtd').value = 1;
  $('mQtd').focus();
}

function registerMovement(productId, tipo, qtd, obs) {
  const p = state.products.find(x => x.id === productId);
  if (!p) return false;
  if (tipo === 'saida' && qtd > p.qtd) {
    alert(`Quantidade insuficiente. Em estoque: ${p.qtd}.`);
    return false;
  }
  p.qtd += tipo === 'entrada' ? qtd : -qtd;
  state.movements.push({
    id: uid(), productId, tipo, qtd,
    data: new Date().toISOString(), obs: obs || ''
  });
  save();
  return true;
}

$('movForm').addEventListener('submit', e => {
  e.preventDefault();
  const pid = $('mProduto').value;
  const tipo = $('mTipo').value;
  const qtd = Math.floor(Number($('mQtd').value));
  if (!pid || !(qtd > 0)) { alert('Informe uma quantidade válida.'); return; }
  if (registerMovement(pid, tipo, qtd, $('mObs').value.trim())) {
    $('mQtd').value = 1;
    $('mObs').value = '';
    renderAll();
  }
});

function renderProductSelect() {
  const sel = $('mProduto');
  const atual = sel.value;
  if (state.products.length === 0) {
    sel.innerHTML = '<option value="">Cadastre um produto primeiro</option>';
    return;
  }
  sel.innerHTML = state.products
    .slice().sort((a, b) => a.nome.localeCompare(b.nome))
    .map(p => `<option value="${p.id}">${esc(p.nome)} (${p.qtd})</option>`).join('');
  if (state.products.some(p => p.id === atual)) sel.value = atual;
}

function renderMovements() {
  const tbody = $('movBody');
  tbody.innerHTML = '';
  const lista = [...state.movements].sort((a, b) => new Date(b.data) - new Date(a.data));
  if (lista.length === 0) {
    tbody.innerHTML = '<tr><td colspan="5" class="empty">Nenhuma movimentação ainda.</td></tr>';
    return;
  }
  for (const m of lista) {
    const p = state.products.find(x => x.id === m.productId);
    const tr = document.createElement('tr');
    tr.innerHTML = `
      <td>${fmtDate(m.data)}</td>
      <td>${esc(p ? p.nome : '(produto removido)')}</td>
      <td>${m.tipo === 'entrada' ? '⬆️ Entrada' : '⬇️ Saída'}</td>
      <td class="num">${m.qtd}</td>
      <td>${esc(m.obs)}</td>`;
    tbody.appendChild(tr);
  }
}

$('clearMov').addEventListener('click', () => {
  if (!confirm('Apagar todo o histórico? As quantidades dos produtos não mudam.')) return;
  state.movements = [];
  save(); renderAll();
});

// ---------- Resumo ----------
function renderSummary() {
  const totalSKU = state.products.length;
  const totalQtd = state.products.reduce((s, p) => s + p.qtd, 0);
  const totalValor = state.products.reduce((s, p) => s + p.qtd * p.preco, 0);
  const baixos = state.products.filter(p => p.qtd <= p.minimo);

  $('summaryCards').innerHTML = `
    <div class="card"><span>Produtos cadastrados</span><strong>${totalSKU}</strong></div>
    <div class="card"><span>Itens em estoque</span><strong>${totalQtd}</strong></div>
    <div class="card"><span>Valor total</span><strong>${fmtMoney(totalValor)}</strong></div>
    <div class="card"><span>Abaixo do mínimo</span><strong>${baixos.length}</strong></div>`;

  $('lowList').innerHTML = baixos.length
    ? baixos.map(p => `<li><strong>${esc(p.nome)}</strong> — ${p.qtd} de ${p.minimo} (mín.)</li>`).join('')
    : '<li class="empty">Nenhum item abaixo do mínimo. 👍</li>';
}

// ---------- Backup ----------
$('exportBtn').addEventListener('click', () => {
  const blob = new Blob([JSON.stringify(state, null, 2)], { type: 'application/json' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = `estoque-${new Date().toISOString().slice(0, 10)}.json`;
  a.click();
  URL.revokeObjectURL(a.href);
});

$('importFile').addEventListener('change', async e => {
  const file = e.target.files[0];
  if (!file) return;
  try {
    const data = JSON.parse(await file.text());
    if (!Array.isArray(data.products)) throw new Error('formato inválido');
    if (!confirm('Isso substitui os dados atuais. Continuar?')) { e.target.value = ''; return; }
    state = {
      products: data.products,
      movements: Array.isArray(data.movements) ? data.movements : []
    };
    save(); renderAll();
    alert('Dados importados!');
  } catch (err) {
    alert('Arquivo inválido: ' + err.message);
  }
  e.target.value = '';
});

// ---------- Scanner (câmera) ----------
let html5QrCode = null;
let scannerProcessing = false;
const scannerModal = $('scannerModal');

async function abrirScanner(onDetect) {
  scannerProcessing = false;
  scannerModal.classList.add('open');
  const readerEl = $('reader');
  readerEl.innerHTML = '';

  if (html5QrCode) {
    try { if (html5QrCode.isScanning) await html5QrCode.stop(); } catch (e) {}
    html5QrCode = null;
  }

  html5QrCode = new Html5Qrcode("reader");

  try {
    await html5QrCode.start(
      { facingMode: "environment" },
      {
        fps: 10,
        qrbox: (vw, vh) => ({
          width: Math.floor(vw * 0.85),
          height: Math.floor(vh * 0.4)
        })
      },
      (decodedText) => {
        if (scannerProcessing) return;
        scannerProcessing = true;
        if (navigator.vibrate) navigator.vibrate(80);
        onDetect(decodedText);
        fecharScanner();
      },
      () => {} // ignora falhas de leitura (frame a frame)
    );
  } catch (err) {
    alert('Não foi possível acessar a câmera.\n\n' + err.message +
          '\n\nDica: a câmera só funciona em HTTPS ou localhost.');
    scannerModal.classList.remove('open');
  }
}

async function fecharScanner() {
  if (html5QrCode && html5QrCode.isScanning) {
    try { await html5QrCode.stop(); } catch (e) {}
  }
  scannerModal.classList.remove('open');
}

$('closeScanner').addEventListener('click', fecharScanner);
scannerModal.addEventListener('click', (e) => {
  if (e.target === scannerModal) fecharScanner();
});

// Botão 📷 do formulário de produto
$('scanBtn').addEventListener('click', () => {
  abrirScanner((codigo) => {
    $('pCodigo').value = codigo;
  });
});

// Botão 📷 do formulário de movimentação
$('scanMovBtn').addEventListener('click', () => {
  abrirScanner((codigo) => {
    const c = codigo.trim();
    const p = state.products.find(x => (x.codigo || '').trim() === c);
    if (p) {
      $('mProduto').value = p.id;
    } else {
      if (confirm(`Nenhum produto cadastrado com o código "${c}".\n\nDeseja cadastrar agora?`)) {
        document.querySelector('.tab[data-tab="produtos"]').click();
        $('pCodigo').value = c;
        $('pNome').focus();
      }
    }
  });
});

// ---------- Render geral ----------
function renderAll() {
  renderProducts();
  renderProductSelect();
  renderMovements();
  renderSummary();
}

load();
renderAll();
</script>
</body>
</html>
